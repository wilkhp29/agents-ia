{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-ia.local/schemas/agent-task-envelope.v1.json",
  "title": "Agent task handoff envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version", "run_id", "task_id", "phase", "status", "goal",
    "scope", "data_classification", "permissions", "skills", "rag_context",
    "provenance", "budget", "acceptance", "output_contract", "telemetry"
  ],
  "properties": {
    "envelope_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/id" },
    "task_id": { "$ref": "#/$defs/id" },
    "parent_task_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "phase": { "enum": ["intake", "discovery", "cross_refinement", "feasibility", "sdd", "task_review", "implementation", "verification", "code_review", "qa", "delivery"] },
    "status": { "enum": ["draft", "needs_refinement", "ready", "blocked", "in_progress", "review", "qa", "done"] },
    "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["included", "excluded", "assumptions"],
      "properties": {
        "included": { "$ref": "#/$defs/strings" },
        "excluded": { "$ref": "#/$defs/strings" },
        "assumptions": { "$ref": "#/$defs/strings" }
      }
    },
    "dependencies": { "$ref": "#/$defs/strings" },
    "data_classification": { "enum": ["public_synthetic", "internal", "confidential", "unknown"] },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "allowed_tools", "filesystem_roots", "external_effects"],
      "properties": {
        "mode": { "enum": ["read_only", "workspace_write", "blocked"] },
        "allowed_tools": { "$ref": "#/$defs/strings" },
        "filesystem_roots": { "$ref": "#/$defs/strings" },
        "external_effects": { "enum": ["none", "mock_only", "approval_required"] }
      }
    },
    "attachments": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "skills": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "required", "availability", "version", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "availability": { "enum": ["available", "missing", "unknown"] },
          "version": { "type": ["string", "null"], "minLength": 1 },
          "sha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] }
        }
      }
    },
    "rag_context": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "query_ids", "sources", "untrusted_content_notice"],
      "properties": {
        "status": { "enum": ["available", "not_applicable", "unavailable", "blocked"] },
        "query_ids": { "$ref": "#/$defs/strings" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "untrusted_content_notice": { "const": true }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_sha256", "provider_model", "harness", "runtime_version", "identity_verified"],
      "properties": {
        "profile_id": { "type": ["string", "null"], "minLength": 1 },
        "profile_sha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
        "provider_model": {
          "type": "object", "additionalProperties": false,
          "required": ["expected_provider", "expected_model", "observed_provider", "observed_model", "identity_verified"],
          "properties": {
            "expected_provider": { "type": ["string", "null"], "minLength": 1 },
            "expected_model": { "type": ["string", "null"], "minLength": 1 },
            "observed_provider": { "type": ["string", "null"], "minLength": 1 },
            "observed_model": { "type": ["string", "null"], "minLength": 1 },
            "identity_verified": { "type": "boolean" }
          }
        },
        "harness": { "type": ["string", "null"], "minLength": 1 },
        "runtime_version": { "type": ["string", "null"], "minLength": 1 },
        "identity_verified": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "identity_verified": { "const": true } },
            "required": ["identity_verified"]
          },
          "then": {
            "properties": {
              "provider_model": {
                "properties": {
                  "observed_provider": { "type": "string", "minLength": 1 },
                  "observed_model": { "type": "string", "minLength": 1 },
                  "identity_verified": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_model": {
                "properties": { "identity_verified": { "const": true } },
                "required": ["identity_verified"]
              }
            },
            "required": ["provider_model"]
          },
          "then": {
            "properties": {
              "identity_verified": { "const": true },
              "provider_model": {
                "properties": {
                  "observed_provider": { "type": "string", "minLength": 1 },
                  "observed_model": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_calls", "max_wall_seconds", "max_reported_tokens", "max_reported_cost_usd", "enforcement_status"],
      "properties": {
        "max_calls": { "type": ["integer", "null"], "minimum": 1 },
        "max_wall_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "max_reported_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "max_reported_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "enforcement_status": { "enum": ["enforced_by_runtime", "reported_only", "unavailable", "blocked"] }
      }
    },
    "acceptance": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "description", "verification"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]{2,3}$" },
          "description": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "output_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "max_chars", "required_fields"],
      "properties": {
        "format": { "enum": ["markdown", "json", "patch"] },
        "max_chars": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "required_fields": { "$ref": "#/$defs/strings" }
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "reported_total", "cost", "duration_seconds", "calls"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reported_total": { "type": ["integer", "null"], "minimum": 0 },
        "cost": {
          "type": "object", "additionalProperties": false,
          "required": ["reported_usd", "source", "is_estimate"],
          "properties": {
            "reported_usd": { "type": ["number", "null"], "minimum": 0 },
            "source": { "type": ["string", "null"], "minLength": 1 },
            "is_estimate": { "type": ["boolean", "null"] }
          }
        },
        "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
        "calls": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "notes": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "version", "excerpt"],
      "properties": {
        "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
      "version": { "type": ["string", "null"], "minLength": 1 },
        "excerpt": { "type": ["string", "null"], "maxLength": 12000 }
      }
    }
  }
}
