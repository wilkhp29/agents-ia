{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-ia.local/schemas/ledger.schema.json",
  "title": "Agent task ledger event",
  "description": "One minimized append-only JSONL event. Do not store raw prompts, personal data, secrets, or full tool output.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "class", "agent", "attempts", "tests", "judge", "human", "tokens_in", "tokens_out", "ts"],
  "properties": {
    "task": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "[A-Za-z0-9_-]+"},
    "class": {"enum": ["A", "B", "C", "unknown"]},
    "agent": {"enum": ["product-lead", "product-manager", "product-designer", "deep-researcher", "software-architect", "software-engineer", "code-reviewer", "product-qa", "intake-normalizer", "judge", "judge-auditor", "retro", "unknown"]},
    "attempts": {"type": "integer", "minimum": 0},
    "tests": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 40, "pattern": "[a-z][a-z0-9_]*"}},
    "judge": {"enum": ["pass", "fail", "pending", "not_applicable"]},
    "human": {"enum": ["none", "input", "approval", "blocked"]},
    "tokens_in": {"type": ["integer", "null"], "minimum": 0},
    "tokens_out": {"type": ["integer", "null"], "minimum": 0},
    "ts": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000000},
    "cost_credits": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000000},
    "failure_code": {"enum": ["none", "test_failure", "lint_failure", "type_failure", "build_failure", "tool_timeout", "tool_error", "review_changes_requested", "qa_fail", "blocked", "unknown"]},
    "review_findings": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000},
    "reopened": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000}
  }
}
